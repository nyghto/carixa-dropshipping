<header class="w-full sticky top-0 z-50 bg-[#fafafb]/85 backdrop-blur-md border-b border-black/[0.04]">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="{{ routes.root_url }}" class="font-semibold text-lg tracking-tight text-neutral-900 flex items-center gap-2">
      <span class="w-2.5 h-2.5 rounded-full bg-neutral-900 inline-block"></span>
      <span>{{ shop.name }}</span>
    </a>

    <nav class="hidden md:flex items-center space-x-8 text-[13px] font-medium text-neutral-500 tracking-wide">
      <a href="#hero" class="hover:text-neutral-900 transition">PRODUCTS</a>
      <a href="#features" class="hover:text-neutral-900 transition">TECHNOLOGY</a>
      <a href="#gallery" class="hover:text-neutral-900 transition">GALLERY</a>
      <a href="#design" class="hover:text-neutral-900 transition">DESIGN</a>
      <a href="#order" class="hover:text-neutral-900 transition">BUY NOW</a>
    </nav>

    <div class="flex items-center gap-4">
      <a href="{{ routes.cart_url }}" class="p-2 text-neutral-700 hover:text-neutral-900 transition relative">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="absolute top-1 right-1 w-4 h-4 bg-neutral-900 text-white text-[10px] rounded-full flex items-center justify-center font-bold">
            {{ cart.item_count }}
          </span>
        {%- endif -%}
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
